# Copy to .env for local overrides. Never commit .env.
#
# Production (https://webaux.app) — set these in Coolify (compose already passes them through):
#
# Required:
#   SPRING_PROFILES_ACTIVE=prod
#   PRISM_PUBLIC_BASE_URL=https://webaux.app
#   PRISM_API_BASE_URL=https://webaux.app
#   PRISM_COOKIE_SECURE=true
#   JWT_SECRET=<unique secret, at least 32 characters>
#   PRISM_OTP_BYPASS_ENABLED=true   # temporary OK in prod; use code 111111 until WhatsApp is live
#   PRISM_PAYMENT_BYPASS_ENABLED=false
#   DATABASE_USERNAME=prism
#   DATABASE_PASSWORD=<strong password>
#
# Recommended:
#   PRISM_ADMIN_INITIAL_NAME=WebAux Admin
#   PRISM_ADMIN_INITIAL_PHONE=<E.164 digits, e.g. 919176791836>
#   PRISM_ADMIN_INITIAL_PASSWORD=<at least 10 characters>
#
# AI generation (optional embeddings + models):
#   PRISM_AI_DESIGN_EMBEDDING_PROVIDER=openrouter
#   PRISM_AI_DESIGN_EMBEDDING_MODEL=openai/text-embedding-3-small
#   PRISM_AI_DESIGN_EMBEDDING_DIMENSIONS=1536
#   PRISM_AI_MAX_GENERATIONS_PER_USER=100
#   OPENROUTER_API_KEY=<key>
#   OPENROUTER_PLANNING_MODEL=...
#   OPENROUTER_GENERATION_MODEL=...
#   OPENROUTER_REPAIR_MODEL=...
#   OPENROUTER_MAX_OUTPUT_TOKENS=16000
#
# Real OTP / payments when ready:
#   WHATSAPP_ENABLED=true + WHATSAPP_* credentials
#   RAZORPAY_ENABLED=true + RAZORPAY_* credentials
#   Webhook: https://webaux.app/api/v1/payments/webhooks/razorpay
#
# Point DNS + TLS at the frontend service only (container port 8080).
# The app refuses to start in prod if payment bypass is on, cookie secure is off,
# or JWT_SECRET is missing/weak/default. OTP bypass is allowed until WhatsApp is live.
# Compose defaults bypass flags to false; keep the local values below for docker compose.

SPRING_PROFILES_ACTIVE=local

DATABASE_URL=jdbc:postgresql://localhost:5432/prism
DATABASE_USERNAME=prism
DATABASE_PASSWORD=change_me

JWT_SECRET=replace_with_a_secure_secret_at_least_32_chars
JWT_ACCESS_TOKEN_EXPIRY=900
JWT_REFRESH_TOKEN_EXPIRY=604800

# Local development only. Both must be false in production.
PRISM_OTP_BYPASS_ENABLED=true
PRISM_PAYMENT_BYPASS_ENABLED=true

# Optional embeddings for hybrid design-library retrieval. SQL retrieval works without this.
PRISM_AI_DESIGN_EMBEDDING_PROVIDER=
PRISM_AI_DESIGN_EMBEDDING_MODEL=
PRISM_AI_DESIGN_EMBEDDING_DIMENSIONS=1536
PRISM_AI_MAX_GENERATIONS_PER_USER=20
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_PLANNING_MODEL=openrouter/free
OPENROUTER_GENERATION_MODEL=openrouter/free
OPENROUTER_REPAIR_MODEL=openrouter/free
OPENROUTER_MODERATION_MODEL=openrouter/free
OPENROUTER_PLANNING_FALLBACKS=
OPENROUTER_GENERATION_FALLBACKS=
OPENROUTER_REPAIR_FALLBACKS=
OPENROUTER_MODERATION_FALLBACKS=
OPENROUTER_ALLOW_PAID_FALLBACK=false
OPENROUTER_TIMEOUT_SECONDS=120
OPENROUTER_MAX_RETRIES=2
OPENROUTER_MAX_REPAIR_ATTEMPTS=1
OPENROUTER_MAX_FALLBACKS=2
OPENROUTER_MAX_REQUESTS_PER_GENERATION=8
OPENROUTER_MAX_OUTPUT_TOKENS=16000
OPENROUTER_MAX_COST_PER_GENERATION_USD=0
OPENROUTER_DAILY_BUDGET_USD=0

# Website design model strategy (backend only). Missing/invalid defaults to free mode.
# true  = existing OPENROUTER_* free workflow
# false = premium UI/UX models below (verified OpenRouter ids)
WEBAUX_USE_FREE_UI_MODELS=true
WEBAUX_PREMIUM_UI_PRIMARY_MODEL=anthropic/claude-opus-5.5
WEBAUX_PREMIUM_UI_SECONDARY_MODEL=openai/gpt-6-astra
WEBAUX_PREMIUM_UI_FALLBACK_MODEL=google/gemini-4-carbon
WEBAUX_PREMIUM_UI_REFINEMENT_MODEL=moonshotai/kimi-k3.1-pro

# AI image generation during website creation (OpenRouter /images). Off by default.
# Uses the same OPENROUTER_API_KEY. Paid models are never used unless paid fallback is enabled.
PRISM_IMAGE_GENERATION_ENABLED=false
PRISM_IMAGE_PROVIDER=openrouter
PRISM_IMAGE_FREE_FIRST=true
PRISM_IMAGE_PAID_FALLBACK_ENABLED=false
PRISM_IMAGE_MAX_IMAGES_PER_WEBSITE=3
PRISM_IMAGE_MAX_COST_PER_IMAGE_USD=0.05
PRISM_IMAGE_MAX_COST_PER_WEBSITE_USD=0.15
PRISM_IMAGE_MAX_RETRIES=2
PRISM_IMAGE_MODEL_CACHE_MINUTES=360
PRISM_IMAGE_WAIT_SECONDS=120
PRISM_IMAGE_BASE64_ENABLED=false
PRISM_IMAGE_BASE64_MAX_SIZE_KB=2048
PRISM_IMAGE_PREFERRED_MODELS=

PRISM_DAILY_HOSTING_PRICE_PAISE=50000
PRISM_DEFAULT_CURRENCY=INR

PRISM_MEDIA_STORAGE_PATH=./data/media
PRISM_MAX_IMAGE_SIZE_MB=10
PRISM_MAX_VIDEO_SIZE_MB=100
PRISM_MEDIA_RETENTION_DAYS=90

# Vite local: http://localhost:5173 + http://localhost:8080
# Docker Compose local: http://localhost:8088 for both (or set PRISM_HTTP_PORT)
# Production: https://webaux.app for both (no trailing slash)
PRISM_PUBLIC_BASE_URL=http://localhost:5173
PRISM_API_BASE_URL=http://localhost:8080
PRISM_COOKIE_SECURE=false
# Host port published by the frontend container (maps to container listen port 8080).
# In Coolify, set the domain's service port to 8080 (not this host port).
PRISM_HTTP_PORT=8088

WHATSAPP_ENABLED=false
WHATSAPP_BASE_URL=https://graph.facebook.com
WHATSAPP_API_VERSION=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_OTP_TEMPLATE_NAME=

RAZORPAY_ENABLED=false
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Leave phone and password empty to skip seeding a staff account.
# For a local demo, set a phone (country code + number) and a password.
PRISM_ADMIN_INITIAL_NAME=WebAux Admin
PRISM_ADMIN_INITIAL_PHONE=9176791836
PRISM_ADMIN_INITIAL_PASSWORD=
